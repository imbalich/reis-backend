# 设置默认行为，自动处理行尾符
* text=auto

# Python 文件
*.py text eol=lf
*.pyi text eol=lf

# 配置文件
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Shell 脚本
*.sh text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# 压缩文件
*.zip binary
*.tar.gz binary
*.rar binary
